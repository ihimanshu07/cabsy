# Static hosting note: browser apps cannot read .env without a build step.
# Copy these PUBLIC values into js/config.js for a no-build deployment.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
WHATSAPP_NUMBER=YOUR_WHATSAPP_NUMBER
SITE_URL=https://YOUR_DOMAIN

# Server-only Supabase Edge Function secret. Set with `supabase secrets set`.
OPENROUTESERVICE_API_KEY=

# Never add SUPABASE_SERVICE_ROLE_KEY or OPENROUTESERVICE_API_KEY to this project or frontend host.
